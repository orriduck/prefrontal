{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/orriduck/prefrontal/modules/i3a/schema/event.schema.json",
  "title": "I3A Meeting Event v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["protocol_version", "meeting_id", "event_id", "sequence", "previous_event_digest", "timestamp", "kind", "participant_id", "role", "adapter_profile_id", "agenda_id", "turn_id", "semantic_state", "authorization_ref", "payload"],
  "properties": {
    "protocol_version": {"const": "i3a-meeting/v1"},
    "meeting_id": {"type": "string", "minLength": 1},
    "event_id": {"type": "string", "minLength": 1},
    "sequence": {"type": "integer", "minimum": 1},
    "previous_event_digest": {"type": "string", "pattern": "^(GENESIS|sha256:[A-Fa-f0-9]{64})$"},
    "timestamp": {"type": "string", "format": "date-time"},
    "kind": {"enum": ["TASK", "ACK", "SKELETON", "CHECKPOINT", "REPORT", "CORRECTION", "ACCEPT", "REJECT", "EVENT", "HEARTBEAT", "CANCEL_REQUEST", "CANCEL_ACK", "RECOVERY", "DECISION", "BRIEF", "INCIDENT", "PARTICIPANT_ADMITTED", "PARTICIPANT_REMOVED", "CONTROLLER_TRANSFER", "MANIFEST_AMENDMENT"]},
    "participant_id": {"type": "string", "minLength": 1},
    "role": {"enum": ["approval_owner", "controller", "peer", "monitor", "observer"]},
    "adapter_profile_id": {"type": "string", "minLength": 1},
    "agenda_id": {"type": "string", "minLength": 1},
    "turn_id": {"type": "string", "minLength": 1},
    "to": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "depends_on": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "semantic_state": {"type": "string", "minLength": 1},
    "authorization_ref": {"type": "string", "minLength": 1},
    "artifact_refs": {"type": "array", "items": {"type": "string", "pattern": "^(?!/)(?!~)(?!.*\\.\\.)(?!.*://)[A-Za-z0-9][A-Za-z0-9._/-]*$"}, "uniqueItems": true},
    "artifact_revisions": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 1}},
    "artifact_digests": {"type": "object", "additionalProperties": {"type": "string", "pattern": "^sha256:[A-Fa-f0-9]{64}$"}},
    "native_session_commitment": {"type": "string", "pattern": "^sha256:[A-Fa-f0-9]{64}$"},
    "manifest_digest": {"type": "string", "pattern": "^sha256:[A-Fa-f0-9]{64}$"},
    "previous_manifest_digest": {"type": "string", "pattern": "^sha256:[A-Fa-f0-9]{64}$"},
    "review_ref": {"type": "string", "pattern": "^(?!/)(?!~)(?!.*\\.\\.)(?!.*://)[A-Za-z0-9][A-Za-z0-9._/-]*$"},
    "decision_ref": {"type": "string", "pattern": "^(?!/)(?!~)(?!.*\\.\\.)(?!.*://)[A-Za-z0-9][A-Za-z0-9._/-]*$"},
    "brief_ref": {"type": "string", "pattern": "^(?!/)(?!~)(?!.*\\.\\.)(?!.*://)[A-Za-z0-9][A-Za-z0-9._/-]*$"},
    "consensus": {"enum": ["unanimous", "controller-decided-with-dissent", "user-decided"]},
    "payload": {"type": "string"}
  },
  "allOf": [
    {"if": {"properties": {"kind": {"const": "TASK"}}}, "then": {"properties": {"role": {"const": "controller"}}}},
    {"if": {"properties": {"kind": {"enum": ["CORRECTION", "ACCEPT", "REJECT", "DECISION", "BRIEF", "CANCEL_REQUEST", "PARTICIPANT_ADMITTED", "PARTICIPANT_REMOVED", "CONTROLLER_TRANSFER", "MANIFEST_AMENDMENT"]}}}, "then": {"properties": {"role": {"const": "controller"}}}},
    {"if": {"properties": {"kind": {"enum": ["ACK", "SKELETON", "CHECKPOINT", "REPORT", "CANCEL_ACK"]}}}, "then": {"properties": {"role": {"const": "peer"}}}},
    {"if": {"properties": {"kind": {"const": "REPORT"}}}, "then": {"required": ["artifact_refs", "artifact_revisions", "artifact_digests"]}},
    {"if": {"properties": {"kind": {"const": "ACCEPT"}}}, "then": {"required": ["review_ref", "artifact_refs", "artifact_revisions", "artifact_digests"]}},
    {"if": {"properties": {"kind": {"const": "DECISION"}}}, "then": {"required": ["decision_ref", "consensus"]}},
    {"if": {"properties": {"kind": {"const": "BRIEF"}}}, "then": {"required": ["brief_ref"]}},
    {"if": {"properties": {"kind": {"const": "MANIFEST_AMENDMENT"}}}, "then": {"required": ["previous_manifest_digest", "manifest_digest"]}}
  ]
}
